# The appoint worker on proxima: what it lends its CPU and 3090 to, and where.
# Read by `postflight-worker` via `docker compose --env-file`.

# The dispatcher on vm4. The worker dials out to it; nothing calls back.
PF_API_URL=http://192.168.1.104:8080

# Identity, and it has to stay stable: the name is what ties everything real jobs
# have measured about this machine's speed to this machine.
PF_WORKER_NAME=CHANGEME

# A work volume, not the dispatcher's: inputs fetched over HTTP, outputs on their
# way back, and a cache of both so a second cut of one sequence does not refetch
# the master. 15 GB is about three masters; / is at 80% full, hence not more.
PF_WORK_PATH=$HOME/.local/share/postflight/work
PF_WORKER_CACHE_BYTES=15000000000

PF_UID=1000
PF_GID=1000
