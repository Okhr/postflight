# Image and exposure
VS_IMAGE=video-stab:latest
VS_PORT=8080

# Where the data lives. Must contain (or be able to create):
#   inbox/ raw/ merged/ proxies/ out/ projects/ templates/ tmp/ db/
# Keep inbox/ and raw/ on the same filesystem: ingestion then becomes an instant
# rename() instead of a multi-gigabyte copy.
VS_DATA_PATH=./data

# Owner of the files written to /data (`id -u` / `id -g`).
VS_UID=1000
VS_GID=1000

# GPU: GID of the host's `render` group (`getent group render`).
# Only used together with docker-compose.gpu.yml. It varies a lot between
# distributions (991 on Ubuntu 25.04, 105 on Debian 12, 44 or 104 elsewhere), so
# read it on the host rather than trusting this default.
VS_RENDER_GID=991

# Which GPU the host has, if any. The image carries the drivers for all of them;
# what it cannot do is choose how the GPU is handed to the container, because that
# is a Docker-level decision. So pick the matching line, and `docker compose up -d`
# applies it on its own afterwards:
#
#   nothing            no GPU, or a GPU whose stack is broken → everything on CPU
#   ...gpu.yml         AMD or Intel: maps /dev/dri, needs VS_RENDER_GID above
#   ...nvidia.yml      NVIDIA: needs nvidia-container-toolkit on the host
#
# Getting this wrong is not fatal, only slow: the application probes every
# accelerated path by actually running it and falls back to the CPU, then says so
# in the header. An `up` that forgets the override is the classic way to lose the
# GPU silently, which is what this variable exists to prevent.
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml

# auto | cuda | vaapi | cpu. `auto` probes NVDEC then VAAPI by really decoding an
# HEVC 10-bit sample, and keeps the first that works.
#
# `auto` again since 2026-08-14. VAAPI decoding was pinned off after the amdgpu
# driver deadlocked, but the real culprit was found: the machine runs AMD's
# out-of-tree amdgpu-dkms (ROCm stack, modules renamed amdttm/amdkcl/amd_sched),
# and **SIGKILLing ffmpeg while VAAPI jobs were in flight** left it waiting on a
# fence that never signalled — `Trying to push to a killed entity`, then every
# ttm_bo_delayed_delete worker stuck, reboot only. Clean decoding was never the
# problem. The worker now forwards SIGTERM to its children and compose gives it
# 60s, so that path is closed. Measured after the fix: 600 frames in 18.0s with
# VAAPI vs 28.2s on CPU, and a SIGTERM mid-decode leaves the kernel log silent.
VS_HWACCEL=auto

# Ingestion
VS_SCAN_INTERVAL_S=30
# How many consecutive scans at an identical size before a file is ingested.
VS_STABILITY_CHECKS=2
# Two parts of the same recording are contiguous within this gap (measured:
# 0.36 s on a real DJI O4 pair).
VS_SPLIT_GAP_TOLERANCE_S=2.0
# Delete the parts from raw/ after a verified merge (the merged file is lossless
# and holds everything, but the deletion cannot be undone).
VS_PURGE_PARTS_AFTER_MERGE=false

# Derush proxy
VS_PROXY_HEIGHT=960
VS_PROXY_CRF=26
