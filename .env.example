# Images and exposure. Two of them, out of one Dockerfile: the API carries no GPU
# stack, no Gyroflow and no mp4_merge, because it hands work out rather than doing it.
# Measured: 656 MB against the 1.98 GB of the single image that came before.
#
# The published images, so `docker compose pull` gets you running in a minute. Point
# these at the local names (`postflight-api:latest`) to build from this checkout
# instead, which is what you want when you are changing the code.
PF_IMAGE_API=ghcr.io/okhr/postflight-api:latest
PF_IMAGE_WORKER=ghcr.io/okhr/postflight-worker:latest
PF_PORT=8080

# Where the data lives. Must contain (or be able to create):
#   inbox/ raw/ merged/ proxies/ out/ projects/ templates/ tmp/ db/
# Keep inbox/ and raw/ on the same filesystem: ingestion then becomes an instant
# rename() instead of a multi-gigabyte copy.
PF_DATA_PATH=./data

# Owner of the files written to /data (`id -u` / `id -g`).
PF_UID=1000
PF_GID=1000

# GPU: GID of the host's `render` group (`getent group render`).
# Only used together with docker-compose.gpu.yml. It varies a lot between
# distributions (991 on Ubuntu 25.04, 105 on Debian 12, 44 or 104 elsewhere), so
# read it on the host rather than trusting this default.
PF_RENDER_GID=991

# Which GPU the host has, if any. The image carries the drivers for all of them;
# what it cannot do is choose how the GPU is handed to the container, because that
# is a Docker-level decision. So pick the matching line, and `docker compose up -d`
# applies it on its own afterwards:
#
#   nothing            no GPU, or a GPU whose stack is broken → everything on CPU
#   ...gpu.yml         AMD or Intel: maps /dev/dri, needs PF_RENDER_GID above
#   ...nvidia.yml      NVIDIA: needs nvidia-container-toolkit on the host
#
# Getting this wrong is not fatal, only slow: the application probes every
# accelerated path by actually running it and falls back to the CPU, then says so
# in the header. An `up` that forgets the override is the classic way to lose the
# GPU silently, which is what this variable exists to prevent.
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml

# auto | cuda | vaapi | cpu. `auto` probes NVDEC then VAAPI by really decoding an
# HEVC 10-bit sample, and keeps the first that works.
#
# `auto` again since 2026-08-14. VAAPI decoding was pinned off after the amdgpu
# driver deadlocked, but the real culprit was found: the machine runs AMD's
# out-of-tree amdgpu-dkms (ROCm stack, modules renamed amdttm/amdkcl/amd_sched),
# and **SIGKILLing ffmpeg while VAAPI jobs were in flight** left it waiting on a
# fence that never signalled: `Trying to push to a killed entity`, then every
# ttm_bo_delayed_delete worker stuck, reboot only. Clean decoding was never the
# problem. The worker now forwards SIGTERM to its children and compose gives it
# 60s, so that path is closed. Measured after the fix: 600 frames in 18.0s with
# VAAPI vs 28.2s on CPU, and a SIGTERM mid-decode leaves the kernel log silent.
PF_HWACCEL=auto

# Dispatcher and workers
#
# The API is the dispatcher, and it alone opens the database. A worker registers over
# HTTP, claims a job, receives a self-contained spec and posts back what it measured.
# So all it needs to know is where to reach the API.
PF_API_URL=http://api:8000

# The worker's name, and it has to be STABLE: it is its identity, what ties everything
# it measured to its machine. Left empty, the worker takes its hostname, which looks
# stable and is not inside a container (it changes on every recreation, leaving an
# orphaned `worker` row behind).
PF_WORKER_NAME=local

# Shared secret on the worker endpoints. Empty leaves them open, which is fine while
# nothing outside the private network can reach the API. Set it on both sides before
# exposing anything.
PF_WORKER_TOKEN=

# --- A worker on another machine (docker-compose.remote-worker.yml) ---------
#
# A worker that does not mount the dispatcher's volume works that out on its own: the
# API stamps its `data_dir` with a uuid, the worker sends back the one it can read, and
# equality is the whole test. Nothing to configure, because the way this breaks is
# silent (a worker wrongly told it shares the volume fails every job it takes).
#
# Its inputs then arrive over HTTP and its outputs leave the same way. It gets a work
# volume of its own, and this ceiling says how much footage it may cache: it deletes its
# oldest to stay under. Set it a little below the size of the volume you give it; 0
# disables eviction. Ignored by a worker that shares the dispatcher's volume, which
# caches nothing and never deletes anything there.
PF_WORK_PATH=./work
PF_WORKER_CACHE_BYTES=20000000000

# Ingestion (read by the API: it is the one that scans the volume it owns)
PF_SCAN_INTERVAL_S=30
# How many consecutive scans at an identical size before a file is ingested.
PF_STABILITY_CHECKS=2
# Two parts of the same recording are contiguous within this gap, and that gap is the
# only test. Measured on the 179 consecutive pairs of a real O3 collection: the 51
# genuine splits follow within 0.79 s at the very most, and the closest unrelated
# flight is 1.11 s behind, so one second sits between the two populations.
PF_SPLIT_GAP_TOLERANCE_S=1.0
# Delete the parts from raw/ after a verified merge (the merged file is lossless
# and holds everything, but the deletion cannot be undone).
PF_PURGE_PARTS_AFTER_MERGE=false

# --- Database snapshots -----------------------------------------------------
#
# The dispatcher snapshots its own database with `VACUUM INTO`, which produces one
# self-contained file with no `-wal` beside it: copying a live SQLite file instead can
# hand you a database missing its most recent writes without saying so.
#
# Empty means `<data>/backups`, which is the volume that already holds the footage:
# point PF_DATA_PATH at a NAS share and the snapshots are covered by whatever already
# protects the footage. Set it to a path of its own to send them somewhere else.
PF_BACKUP_DIR=
# Hours between snapshots, 0 turns the schedule off. Measured against the newest
# snapshot on disk, not against process start, so restarting does not churn the
# retention.
PF_BACKUP_INTERVAL_H=24
# How many to keep. Only files the snapshotter wrote are ever considered.
PF_BACKUP_KEEP=7

# Derush proxy
PF_PROXY_HEIGHT=960
PF_PROXY_CRF=26
